{
  "name": "@qa/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "gen:types": "node scripts/generate-types.mjs",
    "typecheck": "node scripts/generate-types.mjs --check && node scripts/tsc.mjs -p tsconfig.json --noEmit",
    "build": "node scripts/tsc.mjs -p tsconfig.json",
    "test:scaffold": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.6.0"
  }
}
