# Copy to .env for local development. All values below are placeholders; no secrets live here.
QA_MODE=scaffold
QA_HOST=127.0.0.1
QA_PORT=8000
QA_DATA_DIR=var
QA_ALLOWED_ORIGINS=
QA_MAX_CANDIDATE_KBS=20
QA_MAX_SELECTED_KBS=3
QA_PROBE_TIMEOUT_MS=1500
# Model runtime candidates are configured server-side only; clients never submit endpoints or paths.
# JSON array, e.g. [{"target_id":"ollama","kind":"ollama","display_name":"Local Ollama"}]
QA_RUNTIME_TARGETS=[]
# A1 business mode: run `qa-migrate` first, then start qa-api with QA_MODE=operational.
# Chunking has no implicit default; both values must be set after corpus analysis.
QA_CHUNK_TARGET_TOKENS=
QA_CHUNK_OVERLAP_TOKENS=
QA_KEYWORD_PROFILE=zh-bm25-v1
# Authorized server-side source roots: {"root_id": "absolute path"} (JSON object).
QA_SOURCE_ROOTS={}
